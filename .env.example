# --- PostgreSQL ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=

# --- API ---
API_PORT=3000
NODE_ENV=development

# Секреты подписи токенов. Обязательны, значений по умолчанию нет:
# приложение не стартует, пока они не заданы.
# Сгенерировать каждый отдельно: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Передавать refresh-cookie только по HTTPS.
# Для развёртывания по HTTP оставьте false, иначе браузер отбросит cookie
# и сессия не будет восстанавливаться после перезагрузки страницы.
COOKIE_SECURE=false

# Предел размера тела запроса. Формы CRM короткие; предел не даёт
# одному запросу занять память процесса и отдаёт понятный 413.
BODY_LIMIT=256kb

# Публикация спецификации и интерфейса OpenAPI на /api/docs.
# Установите false, если структура API не должна раскрываться анонимно.
OPENAPI_ENABLED=true

# Проверка версии схемы при старте. Экземпляр с непримененными
# миграциями не стартует и не считается готовым принимать трафик.
# false — только чтобы подняться и выполнить миграции руками.
SCHEMA_CHECK=true

# Каталог файлов: вложения и готовые фоновые выгрузки.
# В контейнере совпадает с точкой монтирования тома.
UPLOADS_DIR=uploads

# Деловой часовой пояс. Применяется и к серверу приложений, и к СУБД:
# в нём считаются границы периодов в отчётах, группировка по месяцам
# и признак просроченной активности.
TZ=Europe/Moscow

# --- Web ---
WEB_PORT=8080
