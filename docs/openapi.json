  "info": {
    "title": "CRM API",
    "description": "API АРМ менеджера по работе с клиентами. Все маршруты требуют access-токена, кроме входа, обновления токена и проверок состояния. Ошибки возвращаются единым форматом: statusCode, code, message, path, requestId, timestamp.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "auth",
      "description": "Вход, обновление токена и сессии"
    },
    {
      "name": "clients",
      "description": "Клиенты и контакты"
    },
    {
      "name": "deals",
      "description": "Сделки и история стадий"
    },
    {
      "name": "activities",
      "description": "Звонки, встречи и письма"
    },
    {
      "name": "offers",
      "description": "Коммерческие предложения"
    },
    {
      "name": "reports",
      "description": "Отчёты и выгрузки"
    },
    {
      "name": "users",
      "description": "Пользователи и роли"
    },
    {
      "name": "health",
      "description": "Проверки состояния"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "refresh-cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "crm_refresh"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {}
