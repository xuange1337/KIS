        <mxCell id="audit" value="AuditLog&lt;br&gt;&lt;br&gt;PK id&lt;br&gt;FK user_id&lt;br&gt;entity&lt;br&gt;entity_id&lt;br&gt;action&lt;br&gt;payload&lt;br&gt;created_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fillColor=#eceff1;strokeColor=#607d8b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="205" height="165" as="geometry"/>
