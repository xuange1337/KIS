        <mxCell id="clients" value="Clients&lt;br&gt;&lt;br&gt;PK client_id&lt;br&gt;name&lt;br&gt;inn&lt;br&gt;industry&lt;br&gt;status&lt;br&gt;source&lt;br&gt;address&lt;br&gt;FK owner_user_id&lt;br&gt;created_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fillColor=#dbeddc;strokeColor=#2e7d32;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="40" width="205" height="205" as="geometry"/>
