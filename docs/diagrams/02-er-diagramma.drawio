<mxfile host="app.diagrams.net">
  <diagram name="Рисунок 2 — ER-диаграмма (основные сущности CRM)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" page="1" pageWidth="1180" pageHeight="780" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
