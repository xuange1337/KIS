        <mxCell id="users" value="Users&lt;br&gt;&lt;br&gt;PK user_id&lt;br&gt;login&lt;br&gt;password_hash&lt;br&gt;full_name&lt;br&gt;role&lt;br&gt;is_active" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fillColor=#dbe7f3;strokeColor=#1c4e80;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="265" width="205" height="150" as="geometry"/>
